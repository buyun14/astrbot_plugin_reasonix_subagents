  "advanced": {
    "type": "object",
    "description": "⚠️ 高风险区",
    "hint": "这些配置影响「只读」防护的工作方式，错误放宽可能导致子代理获得有副作用的工具。除非你清楚自己在做什么，否则请保持为空。",
    "items": {
      "web_tool_names": {
        "type": "list",
        "description": "内置网页工具名清单",
        "hint": "覆盖代码中的 _WEB_TOOLS。留空 = 使用内置默认；非空 = 整体替换。",
        "default": []
      },
      "web_markers": {
        "type": "list",
        "description": "⚠️ 「可作为只读网页工具」的名称/描述特征词",
        "hint": "覆盖代码中的 _WEB_READ_MARKERS。留空 = 使用内置默认；非空 = 整体替换。放宽此列表可能导致子代理获得有副作用的工具。",
        "default": []
      },
      "side_effect_markers": {
        "type": "list",
        "description": "⚠️ 副作用特征词黑名单",
        "hint": "覆盖代码中的 _SIDE_EFFECT_MARKERS。留空 = 使用内置默认；非空 = 整体替换。收紧此列表会削弱防护。",
        "default": []
      },
      "skip_discovery": {
        "type": "list",
        "description": "禁止被自动发现的具体工具名",
        "hint": "覆盖代码中的 _SKIP_DISCOVERY_TOOLS。留空 = 使用内置默认；非空 = 整体替换。",
        "default": []
      }
    }
  }
}